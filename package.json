{
  "name": "latersift",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-extension.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm build && node scripts/package.mjs",
    "test:firefox-extension": "pnpm build && node scripts/test-firefox.mjs",
    "lint:extension": "web-ext lint --source-dir dist --warnings-as-errors --no-config-discovery"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "idb": "^8.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.0",
    "web-ext": "^9.0.0"
  }
}
